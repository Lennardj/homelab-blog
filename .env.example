# SSH
SSH_KEY_DIR=

# Proxmox
TF_VAR_proxmox_api_url=
TF_VAR_proxmox_api_token_id=
TF_VAR_proxmox_api_token_secret=

# Cloudflare
TF_VAR_cloudflare_api_token=
TF_VAR_cloudflare_zone_id=
TF_VAR_cloudflare_account_id=
TF_VAR_domain_name=

# Passwords
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
ALERTMANAGER_SMTP_PASSWORD=
TF_VAR_cloudinit_password=

# Networking
INGRESS_IP=

# Backups (Phase 0)
# The backup-secrets Secret is currently created MANUALLY with kubectl - see
# KNOWLEDGE_BASE.md section 16. These entries are here so the step can be
# automated in Ansible later without rediscovering what is needed.
# WARNING: losing RESTIC_PASSWORD makes every existing backup permanently
# unreadable. Store it outside the cluster.
RESTIC_PASSWORD=
BACKUP_SSH_HOST=192.168.1.174
BACKUP_SSH_USER=backup
BACKUP_REPO_PATH=/backup/restic
