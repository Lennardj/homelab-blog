{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1100px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "base",     "color": "#0d1117", "name": "Background" },
        { "slug": "contrast", "color": "#c9d1d9", "name": "Text" },
        { "slug": "accent-1", "color": "#4ade80", "name": "Terminal green" },
        { "slug": "accent-2", "color": "#8b949e", "name": "Muted" },
        { "slug": "accent-3", "color": "#161b22", "name": "Panel" },
        { "slug": "accent-4", "color": "#30363d", "name": "Border" },
        { "slug": "accent-5", "color": "#484f58", "name": "Dim" },
        { "slug": "accent-6", "color": "#ffffff", "name": "White" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "'JetBrains Mono', 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
        }
      ],
      "fontSizes": [
        { "slug": "small",   "size": "0.85rem", "name": "Small" },
        { "slug": "medium",  "size": "1rem",    "name": "Medium" },
        { "slug": "large",   "size": "1.2rem",  "name": "Large" },
        { "slug": "x-large", "size": "2.4rem",  "name": "Extra large" }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "1.02rem",
      "lineHeight": "1.75"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--accent-1)" }
      },
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "fontWeight": "700"
        },
        "color": { "text": "var(--wp--preset--color--accent-1)" }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "1.5rem"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "1.1rem"
        }
      }
    }
  }
}

